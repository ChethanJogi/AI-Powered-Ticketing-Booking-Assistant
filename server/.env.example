# ---- Core ----
PORT=8000
NODE_ENV=development
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:5173
# Public URL of the frontend (used in WhatsApp links)
FRONTEND_URL=http://localhost:5173
# SQLite file location (relative to /server). Use :memory: for throw-away runs.
DATABASE_PATH=./data/ticketai.db

# ---- Secrets (REQUIRED in production, any long random string) ----
JWT_SECRET=change-me-to-a-long-random-string
QR_SECRET=change-me-to-another-long-random-string

# ---- WhatsApp Cloud API (optional) ----
# Set WHATSAPP_ENABLED=true and fill the rest to turn the bot + notifications on.
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-string-and-paste-it-in-meta-dashboard
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Shown on the Profile page as a wa.me link, digits only with country code, e.g. 919876543210
WHATSAPP_PUBLIC_NUMBER=
# Optional approved template used when the 24h chat window is closed
# (body params: {{1}} event title, {{2}} date, {{3}} booking id)
WHATSAPP_TEMPLATE_BOOKING=
WHATSAPP_TEMPLATE_LANG=en

# Admin portal account (created on first start if no admin exists).
# Development: if unset, admin@ticketai.in / demo123 is created. Production: set both (password >= 8 chars) or no admin is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=
